---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="section" id="about">
  <h2>{t.about.title}</h2>
  <p class="about-role">{t.about.role}</p>
  <p class="section-intro">{t.about.tagline}</p>
  <p class="about-story">{t.about.story}</p>
  <p class="about-not">{t.about.not}</p>
  <div class="stat-grid">
    {t.about.stats.map((stat: { value: string; unit: string; label: string }) => (
      <div class="stat">
        <span class="stat-value">{stat.value}</span>
        {stat.unit && <span class="stat-unit">{stat.unit}</span>}
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </div>
  <p class="about-asset">{t.about.asset}</p>
</section>
