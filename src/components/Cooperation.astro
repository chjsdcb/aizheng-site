---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="section page-section" id="cooperation">
  <h2>{t.cooperation.title}</h2>
  <p class="section-intro">{t.cooperation.intro}</p>
  <h3 class="cooperation-subtitle">{t.cooperation.phasesTitle}</h3>
  <ol class="phases">
    {t.partners.phases.map((phase: { code: string; title: string; description: string }) => (
      <li class="phase">
        <span class="phase-badge">{phase.code}</span>
        <h3>{phase.title}</h3>
        <p>{phase.description}</p>
      </li>
    ))}
  </ol>
  <h3 class="cooperation-subtitle">{t.contact.title}</h3>
  <ul class="contact-list">
    <li>
      <span class="contact-label">{t.contact.emailLabel}</span>
      <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
    </li>
    <li>
      <span class="contact-label">{t.contact.wechatLabel}</span>
      <span>{t.contact.wechat}</span>
    </li>
    <li>
      <span class="contact-label">{t.contact.linkedinLabel}</span>
      <a href={t.contact.linkedin} target="_blank" rel="noopener noreferrer">{t.contact.linkedin}</a>
    </li>
  </ul>
</section>
