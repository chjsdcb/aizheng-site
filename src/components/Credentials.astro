---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="section" id="credentials">
  <h2>{t.credentials.title}</h2>
  <p class="section-intro">{t.credentials.intro}</p>
  <div class="stat-grid">
    {t.credentials.stats.map((stat: { value: string; unit: string; label: string }) => (
      <div class="stat">
        <span class="stat-value">{stat.value}</span>
        {stat.unit && <span class="stat-unit">{stat.unit}</span>}
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </div>
  <ul class="credential-list">
    {t.credentials.items.map((item: string) => (
      <li>
        <span class="check" aria-hidden="true">✓</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</section>
