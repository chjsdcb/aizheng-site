---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <p class="footer-tagline">{t.footer.tagline}</p>
    <p class="footer-meta">
      © {new Date().getFullYear()} {t.siteTitle} ·
      <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a> ·
      {t.contact.wechatLabel}: {t.contact.wechat}
    </p>
  </div>
</footer>
