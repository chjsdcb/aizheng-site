---
interface Props {
  t: Record<string, any>;
  locale: 'en' | 'zh';
}

const { t, locale } = Astro.props;
const homeHref = locale === 'en' ? '/' : '/zh/';
const langRoot = locale === 'en' ? '' : '/zh';
const path = Astro.url.pathname;
const isZh = path === '/zh/' || path.startsWith('/zh/');
const enPath = isZh ? path.replace(/^\/zh/, '') || '/' : path;
const zhPath = isZh ? path : (path === '/' ? '/zh/' : '/zh' + path);
const nav = [
  { label: t.nav.about, href: `${homeHref}#about` },
  { label: t.nav.method, href: `${homeHref}#method` },
  { label: t.nav.solutions, href: `${langRoot}/solutions` },
  { label: t.nav.works, href: `${langRoot}/works` },
  { label: t.nav.framework, href: `${langRoot}/framework` },
  { label: t.nav.cooperation, href: `${langRoot}/contact` },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={homeHref} aria-label={t.siteTitle}>
      <span class="brand-mark" aria-hidden="true">AI</span>
      <span class="brand-name">{t.siteTitle}</span>
    </a>
    <nav aria-label={t.navLabel}>
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="lang-switch" role="group" aria-label="Language">
      <a href={enPath} class={!isZh ? 'active' : ''} hreflang="en">EN</a>
      <span aria-hidden="true">/</span>
      <a href={zhPath} class={isZh ? 'active' : ''} hreflang="zh">中文</a>
    </div>
  </div>
</header>
