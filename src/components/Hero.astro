---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="hero" id="home">
  <h1>{t.hero.h1}</h1>
  <p class="hero-sub">{t.hero.sub}</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="#services">{t.hero.cta}</a>
  </div>
  <ul class="hero-anchors">
    {t.hero.anchors.map((anchor: { label: string; value: string }) => (
      <li>
        <span class="anchor-label">{anchor.label}</span>
        <span class="anchor-value">{anchor.value}</span>
      </li>
    ))}
  </ul>
</section>
