---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="section" id="onepager">
  <h2>{t.onepager.title}</h2>
  <p class="section-intro">{t.onepager.intro}</p>
  <form class="email-gate" id="onepager-form" action="https://formspree.io/f/maewvqyb" method="POST">
    <label for="onepager-email">{t.onepager.emailLabel}</label>
    <input id="onepager-email" name="email" type="email" placeholder={t.onepager.emailPlaceholder} required autocomplete="email" />
    <input type="hidden" name="tag" value={t.onepager.tag} />
    <input type="hidden" name="_subject" value={t.onepager.subject} />
    <button class="btn btn-primary" type="submit">{t.onepager.button}</button>
  </form>
  <p class="sla-note">{t.onepager.sla}</p>
  <p class="form-note form-success" id="onepager-note" hidden>{t.onepager.success}</p>
  <p class="form-note form-error" id="onepager-error" hidden>{t.onepager.error}</p>
</section>

<script>
  const form = document.getElementById('onepager-form') as HTMLFormElement | null;
  const note = document.getElementById('onepager-note') as HTMLElement | null;
  const error = document.getElementById('onepager-error') as HTMLElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (error) error.hidden = true;
    const email = new FormData(form).get('email');
    if (!email) return;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        form.hidden = true;
        if (note) note.hidden = false;
      } else if (error) {
        error.hidden = false;
      }
    } catch {
      if (error) error.hidden = false;
    }
  });
</script>
