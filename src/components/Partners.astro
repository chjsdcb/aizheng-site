---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section class="section" id="partners">
  <h2>{t.partners.title}</h2>
  <p class="section-intro">{t.partners.intro}</p>
  <ol class="phases">
    {t.partners.phases.map((phase: { code: string; title: string; description: string }) => (
      <li class="phase">
        <span class="phase-badge">{phase.code}</span>
        <h3>{phase.title}</h3>
        <p>{phase.description}</p>
      </li>
    ))}
  </ol>
</section>
